# Optional. The suite makes no network calls unless an OpenAI-backed role is used.
OPENAI_API_KEY=

# Current defaults; every role can be overridden from code or environment.
ARCWORLD_REASONER_MODEL=gpt-5.6-sol
ARCWORLD_REASONER_EFFORT=high
ARCWORLD_UTILITY_MODEL=gpt-5.6-luna
ARCWORLD_UTILITY_EFFORT=low
